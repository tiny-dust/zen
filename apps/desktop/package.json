{
  "name": "@zen/desktop",
  "version": "0.3.2",
  "private": true,
  "productName": "Zen",
  "desktopName": "zen.desktop",
  "main": "out/main/index.js",
  "bin": {
    "zen-cli": "./src/cli/zen-cli.mjs"
  },
  "build": {
    "appId": "com.zen.desktop",
    "productName": "Zen",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "src/cli/zen-cli.mjs",
        "to": "cli/zen-cli.mjs"
      }
    ],
    "afterSign": "scripts/mac-after-sign.mjs",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Zen 需要使用麦克风进行语音输入识别",
        "NSSpeechRecognitionUsageDescription": "Zen 需要语音识别权限将语音转为文字"
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "executableName": "zen"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "syncDesktopName": true,
      "executableName": "zen"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/@lydell/node-pty-*/prebuilds/**"
    ],
    "publish": {
      "provider": "generic",
      "url": "http://localhost:8899"
    }
  },
  "scripts": {
    "predev": "bash scripts/brand-dev-app.sh",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "node scripts/package.mjs",
    "updates:serve": "node scripts/updates-server.mjs",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "brand:dev": "bash scripts/brand-dev-app.sh",
    "cli:link": "npm link",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.15",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.15",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.15",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.15",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.15",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.15",
    "@mozilla/readability": "0.6.0",
    "@zen/agent-core": "workspace:*",
    "@zen/mcp-client": "workspace:*",
    "@zen/shared": "workspace:*",
    "@zen/skills": "workspace:*",
    "@zen/tools-browser": "workspace:*",
    "@zen/tools-terminal": "workspace:*",
    "@zen/tools-fs": "workspace:*",
    "better-sqlite3": "13.0.3",
    "electron-updater": "6.8.9",
    "jsdom": "27.0.0",
    "rattail": "2.2.0",
    "turndown": "7.2.1"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "5.0.0",
    "electron": "44.3.0",
    "electron-builder": "26.16.1",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  },
  "description": "Zen — 极致精简，专注编程的 AI Agent 桌面端",
  "author": {
    "name": "Reynold"
  }
}
