{
  "name": "@zen/desktop",
  "version": "0.1.0",
  "private": true,
  "productName": "Zen",
  "desktopName": "zen.desktop",
  "main": "out/main/index.js",
  "build": {
    "appId": "com.zen.desktop",
    "productName": "Zen",
    "executableName": "zen",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "syncDesktopName": true
    },
    "npmRebuild": false,
    "publish": {
      "provider": "generic",
      "url": "http://localhost:8899"
    }
  },
  "scripts": {
    "predev": "bash scripts/brand-dev-app.sh",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "node scripts/package.mjs",
    "updates:serve": "node scripts/updates-server.mjs",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "brand:dev": "bash scripts/brand-dev-app.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zen/shared": "workspace:*",
    "@zen/agent-core": "workspace:*",
    "@zen/skills": "workspace:*",
    "@zen/mcp-client": "workspace:*",
    "@zen/tools-browser": "workspace:*",
    "@zen/tools-terminal": "workspace:*",
    "better-sqlite3": "13.0.3",
    "electron-updater": "6.8.9",
    "node-pty": "1.1.0",
    "rattail": "2.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.2",
    "@vitejs/plugin-vue": "6.0.8",
    "electron": "44.3.0",
    "electron-builder": "26.16.1",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "description": "Zen — 极致精简，专注编程的 AI Agent 桌面端",
  "author": {
    "name": "Reynold"
  }
}
