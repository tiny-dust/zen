  "narrative": {
    "northStar": "静默而有序的工作台 (The Quietly Ordered Workbench)",
    "overview": "Zen 的界面是一张熟悉、克制的工作台面：深色中性灰阶承载一切，唯一的暖橙强调色只出现在「发送」按钮和真正需要引起注意的强调点。它不表演智能、不装饰过程，把全部注意力让给代码、结果和下一步动作。层级靠表面明度递进和发丝线分隔来建立，不靠大块颜色。密度按开发者习惯收紧：正文 13px、列表行高 30px、控件高 28px。",
    "keyCharacteristics": [
      "深色为默认主题；浅色主题通过同一组 token 支持。",
      "唯一强调色暖橙 #ff6a2b，任一屏占比 ≤10%。",
      "12px 全局圆角、1.5 图标线宽、克制的双层阴影三档。",
      "消息区无气泡：assistant 内容裸 markdown 铺在背板上。",
      "聚焦/选中只做颜色反馈，禁止粗圈描边。"
    ],
    "rules": [
      { "name": "The One Accent Rule", "body": "暖橙 #ff6a2b 在任何一屏占比 ≤10%。它只标记「当前可执行的主动作」与状态强调点。", "section": "colors" },
      { "name": "The State-by-Light Rule", "body": "灰阶表面之间的层级靠明度递进 + 发丝线建立，不靠颜色块。", "section": "colors" },
      { "name": "The One Family Rule", "body": "一个无衬线家族承担全部 UI 文字，等宽仅限代码/标识数据。层级靠字重与字号，不靠换字体。", "section": "typography" },
      { "name": "The Flat-By-Default Rule", "body": "表面静止时是平的。阴影是对状态的响应，不是默认装饰。", "section": "elevation" }
    ],
    "dos": [
      "用灰阶表面明度递进 + 发丝线建立层级，颜色只用于状态与强调。",
      "保持 12px 圆角、1.5 图标线宽、32px 行高按钮的全局一致性。",
      "用文字 + 图标 + 结构共同表达状态，不只靠红绿颜色。",
      "聚焦态只用边框/底色变化一档，禁用粗圈描边。"
    ],
    "donts": [
      "用营销落地页式的英雄区、装饰性渐变、重复卡片网格、无意义动画。",
      "把工具调用渲染成命令/参数/说明的调试面板，隐藏真实命令结果或 diff。",
      "用 border-left/right > 1px 做彩色侧边条强调。",
      "用 background-clip: text 渐变文字。",
      "给卡片同时加 1px 描边和 ≥16px 模糊宽阴影。",
      "在组件里写死十六进制色值，一律引用 styles.css 的 CSS 变量。",
      "引入第二个 sans 字体家族。"
    ]
  }
